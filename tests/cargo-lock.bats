#!/usr/bin/env bats
#
# scripts/cargo-lock-packages.sh: every [[package]] in every Cargo.lock under a
# root, with the line it starts on and whether it comes from git. osv.jq uses
# the line to place a deprecated-package finding and the git flag to drop a
# crate that merely shares a name and version with a yanked crates.io release.

load helper

SCRIPT="$ROOT/scripts/cargo-lock-packages.sh"

setup() { TMP="$(mktemp -d)"; }
teardown() { rm -rf "$TMP"; }

# lockfile <relative path> -- a registry crate (line 5), a git crate (line 11)
# and a path crate with no source line (line 17)
lockfile() {
    mkdir -p "$TMP/$(dirname "$1")"
    cat > "$TMP/$1" <<'LOCK'
# This file is automatically @generated by Cargo.
# It is not intended for manual editing.
version = 4

[[package]]
name = "spin"
version = "0.9.8"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "6980e8d7511241f8acf4aebddbb1ff938df5eebe98691418c4468d0b72a96a67"

[[package]]
name = "sp-api-proc-macro"
version = "15.0.0"
source = "git+https://github.com/example/polkadot-sdk.git?tag=t#9c7455ea"
dependencies = [
 "spin",
]
[[package]]
name = "local-crate"
version = "0.1.0"
LOCK
}

@test "lists every package with its starting line" {
    lockfile Cargo.lock
    run bash "$SCRIPT" "$TMP"
    [ "$status" -eq 0 ]
    [ "$(jq 'length' <<< "$output")" = 3 ]
    [ "$(jq -r '.[] | select(.name == "spin") | "\(.version) \(.line)"' <<< "$output")" = "0.9.8 5" ]
    [ "$(jq -r '.[] | select(.name == "local-crate") | .line' <<< "$output")" = 18 ]
}

@test "marks git-sourced packages and nothing else" {
    lockfile Cargo.lock
    run bash "$SCRIPT" "$TMP"
    [ "$(jq -r '.[] | select(.name == "sp-api-proc-macro") | .git' <<< "$output")" = true ]
    [ "$(jq -r '.[] | select(.name == "spin") | .git' <<< "$output")" = false ]
    [ "$(jq -r '.[] | select(.name == "local-crate") | .git' <<< "$output")" = false ]
}

@test "paths are relative to the root, for every lockfile under it" {
    lockfile Cargo.lock
    lockfile tools/cli/Cargo.lock
    run bash "$SCRIPT" "$TMP"
    [ "$(jq -r '[.[].path] | unique | join(" ")' <<< "$output")" = "Cargo.lock tools/cli/Cargo.lock" ]
}

@test "a tree with no Cargo.lock prints an empty array" {
    run bash "$SCRIPT" "$TMP"
    [ "$status" -eq 0 ]
    [ "$output" = "[]" ]
}

# Cargo.lock has tables other than [[package]]: [[patch.unused]] carries a name
# and version, [metadata] carries checksums. Fields outside a package block must
# not be read, or the last package's record is overwritten - and a `source =
# "git+` line in another table would mark a registry crate as git and drop its
# finding.
@test "fields outside a [[package]] block are ignored" {
    lockfile Cargo.lock
    cat >> "$TMP/Cargo.lock" <<'LOCK'

[[patch.unused]]
name = "unused-patch"
version = "9.9.9"
source = "git+https://github.com/example/unused.git#deadbeef"

[metadata]
"checksum spin 0.9.8" = "6980e8d7511241f8acf4aebddbb1ff938df5eebe98691418c4468d0b72a96a67"
LOCK
    run bash "$SCRIPT" "$TMP"
    [ "$status" -eq 0 ]
    [ "$(jq 'length' <<< "$output")" = 3 ]
    [ "$(jq -r '.[] | select(.name == "local-crate") | "\(.version) \(.line) \(.git)"' <<< "$output")" = "0.1.0 18 false" ]
    [ "$(jq '[.[] | select(.name == "unused-patch")] | length' <<< "$output")" = 0 ]
}
